  "definitions": {
   "stock": "dette brute / PIB (dette de fin d'année précédente pour la décomposition)",
   "prix": "taux implicite : intérêts de l'année / dette de fin d'année précédente (convention de la BCE ; différent du « coût apparent » d'Eurostat, fondé sur la dette moyenne)",
   "charge": "intérêts / recettes publiques",
   "transmission": "part de la dette à moins d'un an ; écart taux à 10 ans − prix"
  },
  "definitions_en": {
   "stock": "gross debt / GDP (debt at the end of the previous year for the decomposition)",
   "prix": "implicit interest rate: interest for the year / debt at the end of the previous year (ECB convention; differs from Eurostat's \"apparent cost\", based on average debt)",
   "charge": "interest / public revenue",
   "transmission": "share of debt due within one year; 10-year yield minus implicit interest rate"
  },
  "niveaux_en": {
   "europe": "strictly comparable (Eurostat S.13, ESA 2010)",
   "avances": "with reservations (OECD Economic Outlook, SNA gross financial liabilities, gross interest)",
   "emergents": "indicative (IMF WEO and World Bank, central government)"
  },
