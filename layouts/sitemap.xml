{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Surcharge du gabarit embarque Hugo 0.147 (tpl/tplimpl/embedded/templates/sitemap.xml).
       Seul ajout : une page qui AGREGE du contenu (front matter `aggregates: [publications, livres, awp]`)
       prend pour lastmod la date la plus recente des pages qu'elle agrege, lue sur le site FR (le corpus
       des publications n'existe qu'en FR ; le mur presse EN le lit deja ainsi). Sans cela, /a-propos/,
       /serie-awp/ et /en/publications/ n'avaient AUCUN lastmod : une nouvelle parution y changeait la
       page sans qu'un moteur en soit averti (constat du 2026-09-02). Aucune fausse fraicheur : la date
       vient d'une fiche reellement ajoutee ou modifiee.
       Second ajout (2026-09-29) : une page dont les CHIFFRES viennent d'un fichier de donnees
       (front matter `donnees: [dette_officielle]`) prend aussi la date `releve_le` de ce fichier,
       si elle est plus recente. Le generateur ne reecrit `releve_le` que lorsqu'un chiffre a bouge
       (scripts/update_dette_insee.py, en-tete) : aucune fraicheur fictive. Sans cela, le passage
       des donnees au T2 2026 laissait /cout-de-la-dette-publique/ au 21/09 dans le sitemap. */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range where .Pages "Sitemap.Disable" "ne" true }}
    {{- if .Permalink -}}
    {{- /* Date de la page : partial page-date.html, source unique partagee avec le balisage et la ligne visible
           (2026-10-16). Il porte les deux ajouts decrits en tete (agregats, jeux de donnees) et `date_suit:`. */ -}}
    {{- $lm := (partial "page-date.html" .).mod -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not $lm.IsZero }}
    <lastmod>{{ safeHTML ( $lm.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.LanguageCode }}"
                href="{{ .Permalink }}"
                />{{ end }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.LanguageCode }}"
                href="{{ .Permalink }}"
                />{{ end }}
  </url>
    {{- end -}}
  {{ end }}
</urlset>
